{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BFR Macro & Tracking Utility",
  "version": "2.0.0",
  "identifier": "com.bfrmacro.tauri.dev",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "BFR Macro & Tracking Utility"
      }
    }
  }
}
